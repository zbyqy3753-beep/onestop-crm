# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ⚠️ התבנית עצמה כן נכנסת: היא מכילה placeholders בלבד, וזה הקובץ
# היחיד שמסביר איזה משתנים המערכת צריכה. `.env*` בלע גם אותו.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# בוט הוואטסאפ — פרויקט npm נפרד
/bot/node_modules
/bot/auth
/bot/qr.png

# הלוג של הבוט, נוצר בזמן ריצה
/bot/bot.log
/bot/lid-map.json

# נכסים שנוצרים לדף החנות (נגזרים מ-public/icons)
/build-assets

# ⚠️ קבצי עבודה שיושבים בשורש ואסור שייכנסו למאגר.
#
# `mobisale-employees.*` הם רשימת עובדים אמיתית — שם, טלפון, תפקיד.
# הם היו untracked אך **לא** מוגנים, כלומר `git add .` אחד היה מפרסם
# אותם ל-remote לצמיתות; מחיקה מאוחרת אינה מוחקת מההיסטוריה.
# תבנית ולא שמות מפורשים: כבר צצו כמה גרסאות (`-employees`, `-workers-crm`),
# ורשימה מפורשת מפספסת את הייצוא הבא שמישהו ישמור כאן.
/mobisale-*.csv
/mobisale-*.xlsx

# טיוטות וסקריפטים חד-פעמיים
/tmp-*.ts
/work-edit.html
/work-edit.png

