// סכמת ONE STOP CRM.
//
// Prisma ORM 7. חיבור מבוסס driver adapter (@prisma/adapter-pg) —
// עובד מול כל Postgres שמקבל connection string רגיל: Supabase,
// RDS, Neon, או שרת Postgres רגיל.
//
// כדי לחבר Supabase:
//   1. צור פרויקט ב-supabase.com, הגדר ב-.env:
//        DATABASE_URL  — ה-connection pooler (transaction mode, פורט 6543)
//        DIRECT_URL    — חיבור ישיר (session mode, פורט 5432), למיגרציות
//      (ראה .env.example)
//   2. npx prisma migrate dev --name init   (בונה את כל הטבלאות)
//   3. הגדר DATA_SOURCE=prisma ב-.env
//
// שלב 3 הוא היחיד שמשפיע על קוד האפליקציה — הוא מחליף את המימוש
// שמוחזר מ-src/server/repositories/index.ts. שום קומפוננטה לא משתנה.
// המערכת מתחילה ריקה; אין נתוני seed.
//
// חיבור ה-URL עצמו יושב ב-prisma.config.ts, לא כאן — כך דורש Prisma 7.
// prisma.config.ts משתמש ב-DIRECT_URL (לא הפול המשותף) כי כלי המיגרציה
// זקוקים לחיבור ישיר; ה-runtime client (src/server/db/client.ts) משתמש
// ב-DATABASE_URL המאוגם.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ── משתמשים ──────────────────────────────────────────────────────────
 */

enum Role {
  owner
  manager
  bizManager
  shopOwner
  operator
  agent
  employee
  /// ספק לידים חיצוני. לא עובד — הוא **מזין** לידים דרך ה-API ולא
  /// מטפל בהם. רואה מסך יחיד עם הלידים שהוא הביא, ותו לא.
  supplier
  /// אחראי תוכן האתר. ⚠️ **התפקיד היחיד שאינו נכנס ל-CRM כלל.** הוא
  /// מזוהה מול אותו Supabase Auth ויושב באותה טבלה, אבל הסיסמה שלו
  /// פותחת רק את `/admin` של onestop-site. ראה `canUseCrm` ב-
  /// `src/lib/domain/permissions.ts`.
  siteManager
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  phone              String?
  role               Role      @default(agent)
  active             Boolean   @default(true)
  /// שם העסק/החנות המשויכת, אם יש. שדה חופשי — אין ישות Store נפרדת.
  store              String?
  subscriptionEndsAt DateTime?

  /// עבור `supplier` בלבד: הערך שנרשם ב-`Lead.sourceDetail` ללידים
  /// שהוא הביא — כלומר שם השותף מתוך `LEADS_API_KEYS`.
  ///
  /// ⚠️ עמודה נפרדת ולא השוואה מול `name`. השם ב-CRM הוא טקסט תצוגה
  /// שמנהל עלול לערוך ("עידן" → "עידן כהן"), ואילו השם שב-env נקבע
  /// מול מערכת חיצונית. קשירת השניים הייתה מרוקנת לספק את המסך
  /// בשקט, בלי שגיאה ובלי שאיש יבין למה.
  leadSourceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads         Lead[]            @relation("LeadAssignee")
  createdLeads          Lead[]            @relation("LeadCreator")
  notes                 LeadNote[]
  statusEvents          LeadStatusEvent[]
  leadActivity          LeadActivity[]    @relation("LeadActivityActor")
  deals                 Deal[]
  dealStageEvents       DealStageEvent[]
  referredRegistrations Registration[]    @relation("RegistrationReferrer")
  handledRegistrations  Registration[]    @relation("RegistrationHandler")
  whatsappMessages      WhatsAppMessage[] @relation("WaRecipient")
  renewalDocuments      RenewalDocument[] @relation("RenewalUploader")
  sessions              Session[]         @relation("SessionUser")
  impersonatedSessions  Session[]         @relation("SessionImpersonated")
  passwordResets        PasswordReset[]   @relation("PasswordResetUser")
  issuedPasswordResets  PasswordReset[]   @relation("PasswordResetIssuer")
  emailCampaigns        EmailCampaign[]   @relation("EmailCampaignCreator")
  waCampaigns           WaCampaign[]      @relation("WaCampaignCreator")

  @@index([role, active])
}

/// סשן התחברות פעיל.
///
/// ⚠️ העמודה היא **ה-hash של הטוקן**, לא הטוקן. הטוקן עצמו חי רק
/// בעוגייה אצל המשתמש: מי שמשיג גישת קריאה ל-DB מקבל hash-ים, ומהם
/// אי אפשר להרכיב עוגייה תקפה. זו הסיבה היחידה שהעמודה לא נקראת
/// `token`.
///
/// קדם לזה: עוגיית `os_session` הכילה את מזהה המשתמש עצמו, בלי חתימה.
/// כל מי שפתח DevTools והחליף את הערך במזהה של הבעלים — הפך לבעלים,
/// ומזהי משתמשים ממילא מגיעים לדפדפן בשדה `assigneeId` של כל ליד.
model Session {
  /// ה-hash (SHA-256, hex) של הטוקן שיושב בעוגייה
  tokenHash String @id

  userId String
  user   User   @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)

  /// בזמן התחזות: בתור מי הבעלים מחובר. `null` = סשן רגיל.
  /// `userId` נשאר תמיד הזהות **האמיתית**, גם בתוך התחזות.
  impersonatingId String?
  impersonating   User?   @relation("SessionImpersonated", fields: [impersonatingId], references: [id], onDelete: Cascade)

  /// תפוגה מתגלגלת — ראה `touchIfStale` ב-server/auth/session.ts
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// קישור חד-פעמי לקביעת סיסמה חדשה.
///
/// ⚠️ **אותו דפוס כמו `Session`, ומאותה סיבה:** הקישור מחזיק טוקן
/// אקראי, והמסד מחזיק רק את ה-hash שלו. מי שמשיג גישת קריאה למסד לא
/// יכול להרכיב ממנו קישור תקף — וזה קריטי כאן אפילו יותר מבסשן, כי
/// קישור כזה שווה ערך לסיסמה של החשבון.
///
/// ⚠️ **לא נמחק אחרי שימוש — מסומן `usedAt`.** מחיקה הייתה הופכת
/// "הקישור כבר נוצל" ו"הקישור לא היה קיים מעולם" לאותה תשובה בדיוק,
/// ואי אפשר להסביר לעובד מה קרה.
model PasswordReset {
  /// ה-hash (SHA-256, hex) של הטוקן שבקישור
  tokenHash String @id

  userId String
  user   User   @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// מתי נוצל. `null` = עדיין פתוח. חד-פעמיות נאכפת על השדה הזה.
  usedAt    DateTime?

  /// זרימת הקוד: HMAC-SHA256 של הקוד בן 6 הספרות. `null` בזרימת הקישור.
  ///
  /// ⚠️ **HMAC עם סוד מהסביבה ולא SHA-256 רגיל.** לקוד בן 6 ספרות יש
  /// מיליון אפשרויות בלבד — מי שמשיג גישת קריאה למסד היה שובר hash
  /// רגיל בשבריר שנייה, ואז קובע סיסמה חדשה לכל חשבון. הפלפל הופך
  /// דליפת מסד לבדה לחסרת ערך כאן. ראה `PASSWORD_CODE_PEPPER`.
  codeHash String?

  /// ניסיונות שגויים. ⚠️ 6 ספרות נשברות בניחוש אם אין תקרה.
  attempts Int @default(0)

  /// מתי העובד באמת קבע סיסמה חדשה.
  ///
  /// ⚠️ **נפרד מ-`usedAt` בכוונה, ולא כפילות.** `usedAt` נסגר משלוש
  /// סיבות: העובד סיים, הקוד הוחלף בחדש, או שהמנהל איפס שוב. רק
  /// הראשונה מעניינת את מי ששואל "מי כבר טיפל בעצמו". בלי השדה הזה
  /// איפוס חוזר היה מציג את העובד כמי שסיים, בזמן שהוא עדיין נעול.
  completedAt DateTime?

  /// מי הנפיק אותו — ראיה מי אתחל את החשבון ומתי.
  createdById String?
  createdBy   User?   @relation("PasswordResetIssuer", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

/**
 * ── לידים ────────────────────────────────────────────────────────────
 */

/// סדר ההצהרה תואם בכוונה לסדר האמיתי (STATUS_ORDER ב-types.ts) —
/// MySQL ממיין enum-ים לפי סדר ההצהרה (האינדקס הפנימי), וה-repository נשען על כך.
enum LeadStatus {
  new
  /// ליד שנוצר ממסמך חידוש — לקוח עבר שהשנה שלו הסתיימה.
  /// ממוקם מיד אחרי `new` כי זה מצב פתיחה, לא שלב בתהליך.
  recycled
  inProgress
  contacted
  quoteSent
  awaitingClient
  followUp
  futureTracking
  won
  notRelevant
  notInterested
  existingCustomer
  noAnswer
  noAnswer1
  noAnswer2
  returning
  soldByCompetitor
  denies
  lost
}

enum LeadKind {
  hot
  data
}

enum Priority {
  normal
  high
  urgent
}

enum LeadSource {
  manual
  import
  form
  campaign
  referral
}

/// קטגוריית חבילה בקטלוג. שונה מ-LeadCategory (ראה למטה).
enum Category {
  internet
  mobile
  tv
  triple
  fiber
  electricity
}

/// קטגוריית עניין של ליד. שונה מ-Category — יש "general", אין "fiber".
enum LeadCategory {
  mobile
  internet
  tv
  triple
  electricity
  general
  /// לא קטגוריית מוצר אלא **מקור**: הליד הגיע ממסמך חידוש ולא מקמפיין.
  /// אחרון בכוונה — הוא לא מתחרה על אותו ציר עם סלולר/אינטרנט/טלוויזיה.
  recycled
}

enum Provider {
  bezeq
  hot
  yes
  cellcom
  partner
  pelephone
  golan
  ibc
}

model Lead {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?
  city  String?

  kind     LeadKind   @default(data)
  status   LeadStatus @default(new)
  priority Priority   @default(normal)
  source   LeadSource @default(manual)

  category        LeadCategory?
  currentProvider Provider?

  /// עלות רכישת הליד. null = השתמש בעלות של הקטגוריה (טבלת LeadCost).
  /// 0 הוא ערך אמיתי — "הליד הזה היה חינם" — ולכן העמודה nullable.
  cost      Decimal? @db.Decimal(10, 2)
  isStarred Boolean  @default(false)

  /// מאיפה הליד הגיע, כטקסט חופשי: שם הקמפיין, החבילה או הספק
  /// ("פלאפון – 300GB Perfect", "Easy Peasy"). משלים את `source`,
  /// שהוא רשימה סגורה ומתאר רק את *אופן* הקליטה (ידני/ייבוא/טופס).
  sourceDetail String?

  /// החבילה שהלקוח התעניין בה, כטקסט חופשי ("500GB 5G Together").
  ///
  /// טקסט ולא קשר ל-Package בכוונה: שותפים חיצוניים שולחים את שם
  /// החבילה כמחרוזת שלהם, שכמעט לעולם לא תואמת בדיוק לשם בקטלוג
  /// שלנו. אילוץ התאמה היה מוביל לאיבוד המידע כשאין התאמה — וזה
  /// בדיוק המידע שהסוכן צריך לפני שהוא מרים טלפון.
  ///
  /// הקישור לקטלוג האמיתי קורה בשלב העסקה (`Deal.packages`), שם
  /// כבר יודעים איזו חבילה נסגרה בפועל.
  packageName String?

  assigneeId String?
  assignee   User?   @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("LeadCreator", fields: [createdById], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastContactAt DateTime?
  followUpAt    DateTime?

  notes            LeadNote[]
  history          LeadStatusEvent[]
  activity         LeadActivity[]
  deal             Deal?
  whatsappMessages WhatsAppMessage[]
  renewalContacts  RenewalContact[]

  // טלפון הוא מפתח הכפילות בפועל — ייבוא CSV נשען עליו
  @@index([phone])
  @@index([status, updatedAt])
  @@index([assigneeId, status])
  @@index([followUpAt])
}

model LeadNote {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// פעולות על הליד שאינן שינוי סטטוס — יצירה, שיוך, עלות, סימון.
///
/// טבלה נפרדת ולא הרחבה של LeadStatusEvent: שם `to` הוא non-null וכל
/// הקוראים מניחים שכל רשומה היא מעבר סטטוס אמיתי. עירוב היה מחייב
/// להפוך אותו ל-nullable ולשבור אותם.
enum LeadActivityType {
  created
  assigned
  unassigned
  imported
  costChanged
  starred
  unstarred
}

model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type   LeadActivityType
  detail String?

  /// היעד של הפעולה, כשרלוונטי (למשל העובד שהליד שויך אליו)
  targetUserId String?

  actorId String
  actor   User   @relation("LeadActivityActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// כל שינוי סטטוס נשמר עם הפירוט שהסוכן הזין. זו היסטוריית הליד.
model LeadStatusEvent {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  from   LeadStatus?
  to     LeadStatus
  detail String?

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/**
 * ── חבילות ───────────────────────────────────────────────────────────
 */

model Package {
  id          String   @id @default(cuid())
  name        String
  provider    Provider
  category    Category
  /// מחיר חודשי ללקוח. null לחבילות חשמל — אין להן מחיר קבוע.
  price       Decimal? @db.Decimal(10, 2)
  /// עמלת סגירה למשווק — תמיד קיים, גם לחשמל.
  commission  Decimal  @db.Decimal(10, 2)
  /// שדות שמשתנים לפי קטגוריה (ג'יגה, מהירות הורדה, אחוז הנחה וכו').
  /// ראה PACKAGE_SPEC_FIELDS ב-types.ts למקור האמת של אילו שדות שייכים לאיזו קטגוריה.
  spec        Json     @default("{}")
  description String?
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals DealPackage[]

  @@index([provider, category])
  @@index([active])
}

/**
 * ── עסקאות ───────────────────────────────────────────────────────────
 */

/// שלבי מעקב הזמנה — סטפר רב-שלבי, לא רק סטטוס יחיד.
enum DealStage {
  new
  sentToAktiv
  inProgress
  apiProcess
  registered
  awaitingShipment
  awaitingPorting
  awaitingInstall
  active
  approved
  rejected
  cancelled
}

model Deal {
  id String @id @default(cuid())

  /// מזהה תצוגה קצר (כמו "10001"), נפרד מ-id הפנימי
  displayId String @unique

  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id])

  agentId String
  agent   User   @relation(fields: [agentId], references: [id])

  /// קטגוריית הליד המקורי, מועתקת בזמן יצירת העסקה
  category LeadCategory

  /// סכום שנגבה מהלקוח
  revenue      Decimal   @db.Decimal(10, 2)
  note         String?
  currentStage DealStage @default(new)
  closedAt     DateTime  @default(now())

  packages     DealPackage[]
  stageHistory DealStageEvent[]

  @@index([agentId, closedAt])
  @@index([closedAt])
}

/// טבלת קישור — עסקה יכולה לכלול כמה חבילות (טריפל + סלולר וכו').
model DealPackage {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  /// העמלה נשמרת כפי שהייתה ברגע הסגירה, כדי ששינוי מחירון
  /// בעתיד לא ישכתב עמלות היסטוריות.
  commissionAtClose Decimal @db.Decimal(10, 2)

  @@id([dealId, packageId])
}

/// היסטוריית שלבי עסקה — מראה את LeadStatusEvent. מאפשרת ל-stepper
/// להראות אילו שלבים העסקה כבר עברה, לא רק את הנוכחי.
model DealStageEvent {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  from   DealStage?
  to     DealStage
  detail String?

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
}

/**
 * ── הגדרות ───────────────────────────────────────────────────────────
 */

/// עלות רכישת ליד לפי קטגוריית ליד. שורה אחת לכל קטגוריה.
model LeadCost {
  category LeadCategory @id
  cost     Decimal      @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt
}

/**
 * ── טפסי רישום (הפניית שותפים) ──────────────────────────────────────
 */

enum RegistrationStatus {
  pending
  handled
  rejected
}

/// פנייה של בעל עסק חיצוני להצטרפות כשותף — דרך טופס ציבורי משותף,
/// לא ליד מכירה. ישות נפרדת לגמרי מ-Lead.
model Registration {
  id             String  @id @default(cuid())
  businessName   String
  contactName    String
  phone          String
  email          String?
  /// תיאור חופשי של ערוץ ההפניה, למשל "ONE STOP" או שם עובד
  referralSource String

  referredByUserId String?
  referredBy       User?   @relation("RegistrationReferrer", fields: [referredByUserId], references: [id], onDelete: SetNull)

  status RegistrationStatus @default(pending)

  createdAt DateTime  @default(now())
  handledAt DateTime?

  handledById String?
  handledBy   User?   @relation("RegistrationHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([referredByUserId])
}

/**
 * ── תזכורות וואטסאפ ──────────────────────────────────────────────────
 */

enum WaMessageStatus {
  queued
  sending
  sent
  failed
  cancelled
}

/// תור ההודעות היוצאות לוואטסאפ.
///
/// ה-CRM מחליט מה נשלח ולמי ומרנדר את הטקסט; הבוט שרץ על המחשב במשרד
/// רק מושך שורות, שולח, ומדווח. כל ההיגיון והעברית נשארים כאן.
///
/// `toPhone` ו-`body` הם snapshot ולא נגזרים בזמן השליחה: אחרי שההודעה
/// יצאה, מה שנשלח בפועל הוא עובדה היסטורית שלא משתנה כשהליד מתעדכן.
model WhatsAppMessage {
  id String @id @default(cuid())

  /// המפתח שמונע כפילות. לתזכורת חזרה: `followup:<leadId>:<followUpAt ISO>`.
  /// תזמון מחדש מייצר מפתח חדש (= חובה חדשה), ואותה שעה פעמיים היא no-op.
  dedupeKey String @unique

  /// E.164 בלי הפלוס, כפי שוואטסאפ מזהה נמען
  toPhone String
  /// הטקסט המלא בעברית, מרונדר בשרת
  body    String

  status       WaMessageStatus @default(queued)
  /// מתי ההודעה אמורה לצאת. הבוט לא תובע שורות עתידיות.
  scheduledFor DateTime
  /// עולה בכל תביעה. 3 כישלונות = failed, כדי ששורה תקועה לא תסתובב לנצח.
  attempts     Int             @default(0)
  lastError    String?
  claimedAt    DateTime?
  sentAt       DateTime?

  /// מזהה ההודעה אצל מטא (Cloud API).
  ///
  /// ⚠️ זה מה שמקשר עדכון מסירה שמגיע ב-webhook לשורה שלנו. בלעדיו
  /// "נמסר ללקוח" ו"נשלח לספק" הם אותו דבר — וזו בדיוק ההנחה שגרמה
  /// לנו לסמן `sent` על הודעות שאיש לא קיבל בגרסת הבוט.
  ///
  /// ריק בשורות שנשלחו דרך הבוט הישן, שלא היה לו מזהה כזה.
  providerMessageId String? @unique

  /// SetNull ולא Cascade: הגוף והמספר הם snapshot, ומחיקת ליד לא צריכה
  /// למחוק את הראיה שההודעה נשלחה
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  recipientUserId String?
  recipient       User?   @relation("WaRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  /// שיוך לדיוור המוני, כשהשורה נולדה ממסך "דיוור וואטסאפ".
  ///
  /// ⚠️ ריק בכל שאר השורות — תזכורות, התראות וחידושים — וזה בכוונה:
  /// התור אחד, ורק המקור שונה. Cascade ולא SetNull, כי דיוור שנמחק
  /// מוחק גם את השורות שלו: הן חסרות משמעות בלעדיו.
  campaignId String?
  campaign   WaCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([status, scheduledFor])
  @@index([leadId, status])
  @@index([campaignId, status])
}

/// דופק הבוט — שורה יחידה (`id = "default"`).
///
/// הבוט רץ על מחשב במשרד שאף אחד לא מסתכל עליו. בלי הדופק הזה,
/// "לא הגיעו תזכורות" ו"לא היו תזכורות" נראים בדיוק אותו דבר.
model BotHeartbeat {
  id          String   @id @default("default")
  lastSeenAt  DateTime
  /// האם החיבור לוואטסאפ עצמו חי — תהליך שרץ בלי חיבור לא שולח כלום
  waConnected Boolean  @default(false)
  waNumber    String?
  instanceId  String?
  queuedCount Int      @default(0)
}

/**
 * ── חידושים ──────────────────────────────────────────────────────────
 */

enum RenewalDocStatus {
  /// הקובץ נשמר, הטקסט טרם חולץ
  uploaded
  /// חולץ טקסט קריא
  extracted
  /// החילוץ נכשל — PDF סרוק, מוגן בסיסמה, או פגום
  failed
}

/// מסמך PDF של לקוח שהשנה שלו הסתיימה, כפי שהועלה מהאתר.
///
/// שלב ראשון בזרימת החידושים: הקובץ נשמר ב-Supabase Storage (דלי
/// פרטי `renewals`) והטקסט הגולמי נשמר כאן. חילוץ השדות עצמם — שם,
/// טלפון, ספק, חבילה, מחיר — הוא שלב נפרד **בכוונה**: בלי לראות
/// מסמכים אמיתיים כל parser שהיינו כותבים היה ניחוש, והטקסט הגולמי
/// הוא מה שמאפשר לכתוב אותו נכון בלי להעלות הכול מחדש.
model RenewalDocument {
  id       String @id @default(cuid())
  fileName String
  byteSize Int

  /// הנתיב בתוך הדלי. הקובץ עצמו לא במסד — חשבוניות במסד היו מנפחות
  /// אותו לגיגה תוך מאות לקוחות.
  storagePath String

  status        RenewalDocStatus @default(uploaded)
  /// הטקסט כפי שיצא מה-PDF, בלי עיבוד
  extractedText String?
  pageCount     Int?
  error         String?

  /// SHA-256 של תוכן הקובץ.
  ///
  /// ⚠️ ייחודי, וזו לא אופטימיזציית אחסון. אותה חשבונית שהועלתה
  /// פעמיים היא בהמשך שתי הודעות וואטסאפ לאותו לקוח — וזו בדיוק
  /// התלונה שהופכת דיוור לגיטימי לספאם בעיני המקבל.
  contentHash String @unique

  uploadedById String
  uploadedBy   User   @relation("RenewalUploader", fields: [uploadedById], references: [id])

  createdAt       DateTime         @default(now())
  renewalContacts RenewalContact[]

  @@index([status, createdAt])
}

enum RenewalContactStatus {
  /// חולץ מהמסמך, ממתין לאישור אדם לפני שיוצאת הודעה
  pending
  /// אושר — ההודעה נכנסה לתור השליחה
  queued
  /// ההודעה נשלחה, ממתינים לתשובה
  awaitingReply
  /// הלקוח ענה משהו שלא הצלחנו לפענח — דורש עין אנושית
  needsReview
  /// הלקוח נקב בשעה ונוצר ליד
  scheduled
  /// הלקוח סירב
  declined
  /// הלקוח ביקש להסיר אותו מהדיוור
  optedOut
  /// לא ענה בזמן סביר
  noReply
  /// השליחה נכשלה
  failed
}

/// לקוח בודד שחולץ ממסמך חידוש — עמוד אחד = איש קשר אחד.
///
/// ⚠️ זו הישות היחידה במערכת שממנה יוצאת הודעה **ללקוח** ולא לעובד.
/// כל שאר הבוט הוא פנימי. לכן היא מחזיקה גם את הראיות שנדרשות
/// לדיוור חוקי: מה נשלח, מתי, ומה הלקוח ענה — כולל בקשת הסרה.
model RenewalContact {
  id String @id @default(cuid())

  documentId String
  document   RenewalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// העמוד שממנו חולץ. יחד עם המסמך זו הזהות הטבעית.
  pageIndex  Int

  name  String
  /// E.164 בלי הפלוס — אותו פורמט כמו ב-WhatsAppMessage
  phone String
  city  String?
  email String?

  provider       String?
  packageName    String?
  serviceType    String?
  currentPrice   Decimal?  @db.Decimal(10, 2)
  futurePrice    Decimal?  @db.Decimal(10, 2)
  contractEndsAt DateTime?

  status RenewalContactStatus @default(pending)

  /// טקסט העמוד כפי שחולץ. נשמר כדי שאפשר יהיה לתקן את הפרסר בלי
  /// להעלות מחדש, ולראות מה באמת היה כתוב כשהחילוץ טעה.
  rawText String

  /// השעה שהלקוח הסכים לה
  agreedAt DateTime?
  /// הליד שנוצר בעקבות ההסכמה
  leadId   String?
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  sentAt          DateTime?
  lastInboundAt   DateTime?
  lastInboundText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, pageIndex])
  @@index([phone])
  @@index([status, createdAt])
}

/// רשימת ההסרה. מספר שביקש לא לקבל דיוור — לנצח.
///
/// ⚠️ **טבלה נפרדת ולא סטטוס על `RenewalContact`, בכוונה.** סטטוס
/// `optedOut` חי על שורה שאפשר למחוק, ושמתקיימת רק אם המספר בכלל
/// חולץ ממסמך. שתי חורים נובעים מכך: מחיקת מסמך מוחקת בcascade את
/// אנשי הקשר שלו ואיתם את ההסרה, ומספר שביקש הסרה בלי שהיה איש קשר
/// כלל לא נרשם בשום מקום. בשני המקרים העלאת PDF הבאה הייתה מכניסה
/// אותו חזרה ושולחת לו שוב — בדיוק ההפרה שהוא ביקש למנוע.
///
/// המפתח הוא הטלפון עצמו, ולכן הרשומה שורדת כל מחיקה של תוכן.
model RenewalOptOut {
  /// E.164 בלי הפלוס — אותו פורמט כמו ב-RenewalContact ו-WhatsAppMessage
  phone String @id

  /// מה הלקוח כתב בפועל. ראיה לכך שההסרה נדרשה, ומתי.
  body String?

  createdAt DateTime @default(now())
}

/// הודעה נכנסת מלקוח.
///
/// נשמרת **גם כשלא הצלחנו לשייך אותה** לאיש קשר: הודעה ממספר לא
/// מוכר עדיין עשויה להיות "הסר", וזו בקשה שחייבים לכבד ולתעד גם אם
/// לא ידוע מי שלח אותה.
model WhatsAppInbound {
  id String @id @default(cuid())

  /// מזהה ההודעה אצל וואטסאפ — מונע כפילות כשהבוט מדווח פעמיים
  waMessageId String   @unique
  fromPhone   String
  body        String
  receivedAt  DateTime

  /// לאיזה איש קשר שויכה, אם נמצא
  contactId String?
  /// מה המערכת הבינה מההודעה — לתיעוד ולניפוי הפרסר
  parsed    String?

  createdAt DateTime @default(now())

  @@index([fromPhone, receivedAt])
}

/// הגדרות הבוט שמנהל יכול לשנות מהאתר — שורה יחידה (`id = "default"`).
///
/// עד עכשיו כל אלה היו קבועים בקוד, כלומר כל שינוי דרש `git push`
/// ופריסה. הבעיה האמיתית היא לא הנוחות אלא הזמן: כשמתברר שהבוט שולח
/// משהו שגוי, "לעצור" חייב להיות לחיצה אחת ולא מחזור פריסה.
///
/// השורה נקראת בכל סקר של הבוט (כל 60 שניות), ולכן שינוי כאן נכנס
/// לתוקף תוך דקה בלי להפעיל שום דבר מחדש.
model BotSettings {
  id String @id @default("default")

  /// מתג ההשבתה. כשדולק הבוט ממשיך לדווח דופק אבל לא תובע שום שורה —
  /// התור מצטבר ולא הולך לאיבוד, בדיוק כמו כשהמחשב במשרד כבוי.
  paused       Boolean   @default(false)
  pausedReason String?
  pausedAt     DateTime?

  /// חלון השליחה בשעון ישראל. מחוצה לו שורות נכנסות לתור ונדחות לבוקר.
  sendWindowStartHour Int @default(8)
  sendWindowEndHour   Int @default(21)

  /// כמה דקות **לפני** מועד החזרה לשלוח את התזכורת.
  ///
  /// תזכורת שמגיעה בדיוק בשעת החזרה כבר מאחרת: העובד צריך לקרוא
  /// אותה, לפתוח את הפרטים ולחייג. 0 = בדיוק בשעה.
  reminderLeadMinutes Int @default(10)

  /// תקרת הודעות ליום קלנדרי (שעון ישראל). 0 = בלי תקרה.
  ///
  /// לתזכורות פנימיות זה כמעט לא רלוונטי, אבל זו רשת הביטחון היחידה
  /// מפני באג שמייצר לולאת שליחה — ומספר וואטסאפ ששולח מאות הודעות
  /// ביום נחסם.
  dailyCap Int @default(200)

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/**
 * ── נעילת התחברות ────────────────────────────────────────────────────
 */

/// ניסיונות התחברות כושלים, לצורך נעילה זמנית.
///
/// ⚠️ במסד ולא בזיכרון התהליך. הדפוס שב-`api/leads/route.ts` (מפה
/// בזיכרון) מספיק כדי לעצור שותף עם באג בלולאה, אבל לא כדי לעצור
/// ניחוש סיסמאות: ב-Vercel כל אינסטנס מחזיק מונה משלו, והתוקף פשוט
/// מתפזר ביניהם. מונה משותף הוא היחיד שסופר באמת.
///
/// המפתח הוא מזהה ההתחברות **המנורמל** (`toLoginEmail`), ולא הגולמי —
/// אחרת `idan` ו-`idan@onestop.co.il` היו שני מונים נפרדים לאותו חשבון.
///
/// ⚠️ השורה נוצרת גם למזהה שאינו קיים במערכת. בכוונה: אם רק חשבונות
/// אמיתיים היו נספרים, הבדל זמני התגובה בין "ננעל" ל"לא ננעל" היה
/// מסגיר אילו חשבונות קיימים — בדיוק מה שההודעה האחידה מונעת.
model LoginAttempt {
  /// מזהה ההתחברות המנורמל
  loginId String @id

  /// כמה כשלונות רצופים. מתאפס בהתחברות מוצלחת.
  failures Int @default(0)

  /// מתי היה הכישלון האחרון — הבסיס לחלון המתגלגל.
  lastFailedAt DateTime @default(now())

  /// עד מתי החשבון נעול. `null` = לא נעול.
  lockedUntil DateTime?

  @@index([lockedUntil])
}

/**
 * ── דיוור במייל ──────────────────────────────────────────────────────
 */

enum EmailCampaignStatus {
  draft
  sending
  paused
  done
}

enum EmailMessageStatus {
  queued
  sending
  sent
  failed
  cancelled
}

/// דיוור אחד — הרשימה, הטקסט, ומי שלח.
///
/// הנמענים מגיעים מקובץ חיצוני ולא מהלידים, ולכן אין כאן שום קשר
/// ל-`Lead`: הרשימה היא קלט חד-פעמי ולא ישות במערכת.
model EmailCampaign {
  id String @id @default(cuid())

  /// שם פנימי, למסך בלבד
  name String

  /// התבנית **לפני** מיזוג, כפי שהמשתמש כתב אותה. נשמרת לתיעוד
  /// ולשכפול דיוור — לא לשליחה. מה שנשלח יושב ב-`EmailMessage`.
  subjectTemplate String
  bodyTemplate    String

  status EmailCampaignStatus @default(draft)

  /// נקבע ביצירה ולא משתנה. שאר המונים (נשלחו/נכשלו/ממתינים) נספרים
  /// מ-`EmailMessage` ולא נשמרים בשדה — שדה כזה יכול לסתור את התור.
  totalCount Int @default(0)

  createdById String?
  createdBy   User?   @relation("EmailCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  messages EmailMessage[]

  @@index([status, createdAt])
}

/// שורה בתור המיילים היוצאים.
///
/// ⚠️ `subject` ו-`body` הם snapshot מרונדר ולא נגזרים בזמן השליחה,
/// מאותה סיבה שכתובה ב-`WhatsAppMessage`: אחרי שהמייל יצא, מה שנשלח
/// הוא עובדה היסטורית שלא משתנה כשעורכים את הקמפיין.
model EmailMessage {
  id String @id @default(cuid())

  /// `campaign:<campaignId>:<מייל מנורמל>`. זה מה שהופך העלאה כפולה
  /// של אותו קובץ ל-no-op, וגם כתובת שמופיעה פעמיים בקובץ נכנסת פעם אחת.
  dedupeKey String @unique

  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// מנורמל (`normalizeEmail`), כי הוא חלק ממפתח הכפילות
  toEmail String
  toName  String?

  subject String
  body    String

  status       EmailMessageStatus @default(queued)
  scheduledFor DateTime
  /// עולה בכל תביעה. 3 כישלונות = failed.
  attempts     Int                @default(0)
  lastError    String?
  claimedAt    DateTime?
  sentAt       DateTime?

  createdAt DateTime @default(now())

  @@index([status, scheduledFor])
  @@index([campaignId, status])
}

/// מי ביקש להסיר את עצמו. מקביל ל-`RenewalOptOut`.
///
/// ⚠️ נבדק פעמיים — בהעלאה ושוב ברגע התביעה. בין השתיים עוברות שעות,
/// ומי שהסיר את עצמו באמצע לא אמור לקבל את שאר הדיוור.
model EmailOptOut {
  /// המייל המנורמל הוא המפתח
  email     String   @id
  reason    String?
  createdAt DateTime @default(now())
}

/// הגדרות הדיוור — שורה יחידה (`id = "default"`), במקביל ל-`BotSettings`.
///
/// במסד ולא בקוד מאותה סיבה: עצירת דיוור שיצא לא נכון חייבת להיות
/// לחיצה אחת, ומחזור פריסה של Vercel הוא דקות.
model MailerSettings {
  id String @id @default("default")

  paused       Boolean   @default(false)
  pausedReason String?
  pausedAt     DateTime?

  /// חלון שליחה בשעון ישראל. דיוור שיוצא ב-03:00 נראה כמו ספאם.
  sendWindowStartHour Int @default(8)
  sendWindowEndHour   Int @default(21)

  /// תקרה ליום קלנדרי (שעון ישראל). 400 ולא 500 — מתחת לתקרה של
  /// גוגל, כי חשבון שנשרף אינו ניתן לשחזור. 0 = בלי תקרה.
  dailyCap Int @default(400)

  /// כמה מיילים לתקתוק אחד. Gmail חוסם התפרצויות, ולכן לא שולחים
  /// את כל הרשימה בבת אחת גם כשהתקרה מרשה.
  perTick Int @default(20)

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/**
 * ── דיוור בוואטסאפ ───────────────────────────────────────────────────
 */

/// סטטוס דיוור וואטסאפ. ערכים זהים ל-`EmailCampaignStatus` אבל טיפוס
/// נפרד: enum משותף היה קושר שני מסכים שאין ביניהם שום קשר, ושינוי
/// באחד היה נוחת על השני.
enum WaCampaignStatus {
  draft
  sending
  paused
  done
}

/// דיוור המוני אחד — הרשימה, הטקסט, ומי שלח.
///
/// ⚠️ **אין כאן תור משלו.** הנמענים נכנסים ל-`WhatsAppMessage`, אותו
/// תור שממנו יוצאות התזכורות, עם `dedupeKey` בתחילית `broadcast:`.
/// תור שני היה מכפיל את חלון השליחה, את מתג ההשהיה ואת התקרה
/// היומית — ואת התקרה במיוחד אסור לפצל: מטא סופרים מספר אחד.
///
/// הנמענים מגיעים מהדבקה או מקובץ ולא מהלידים, ולכן אין קשר ל-`Lead`.
model WaCampaign {
  id String @id @default(cuid())

  /// שם פנימי, למסך בלבד
  name String

  /// הטקסט **כפי שהמשתמש כתב אותו**, לפני הנרמול לפרמטר תבנית.
  /// נשמר לתיעוד ולשכפול; מה שנשלח בפועל יושב ב-`WhatsAppMessage.body`.
  message String

  status WaCampaignStatus @default(draft)

  /// נקבע ביצירה ולא משתנה. שאר המונים נספרים מהתור, כמו בדיוור במייל.
  totalCount Int @default(0)

  createdById String?
  createdBy   User?   @relation("WaCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  messages WhatsAppMessage[]

  @@index([status, createdAt])
}
