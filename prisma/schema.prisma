// סכמת ONE STOP CRM.
//
// Prisma ORM 7. חיבור מבוסס driver adapter (@prisma/adapter-pg) —
// עובד מול כל Postgres שמקבל connection string רגיל: Supabase,
// RDS, Neon, או שרת Postgres רגיל.
//
// כדי לחבר Supabase:
//   1. צור פרויקט ב-supabase.com, הגדר ב-.env:
//        DATABASE_URL  — ה-connection pooler (transaction mode, פורט 6543)
//        DIRECT_URL    — חיבור ישיר (session mode, פורט 5432), למיגרציות
//      (ראה .env.example)
//   2. npx prisma migrate dev --name init   (בונה את כל הטבלאות)
//   3. הגדר DATA_SOURCE=prisma ב-.env
//
// שלב 3 הוא היחיד שמשפיע על קוד האפליקציה — הוא מחליף את המימוש
// שמוחזר מ-src/server/repositories/index.ts. שום קומפוננטה לא משתנה.
// המערכת מתחילה ריקה; אין נתוני seed.
//
// חיבור ה-URL עצמו יושב ב-prisma.config.ts, לא כאן — כך דורש Prisma 7.
// prisma.config.ts משתמש ב-DIRECT_URL (לא הפול המשותף) כי כלי המיגרציה
// זקוקים לחיבור ישיר; ה-runtime client (src/server/db/client.ts) משתמש
// ב-DATABASE_URL המאוגם.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ── משתמשים ────────────────────────────────────────────────────────── */

enum Role {
  owner
  manager
  bizManager
  shopOwner
  operator
  agent
  employee
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  phone              String?
  role               Role      @default(agent)
  active             Boolean   @default(true)
  /// שם העסק/החנות המשויכת, אם יש. שדה חופשי — אין ישות Store נפרדת.
  store              String?
  subscriptionEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads       Lead[]            @relation("LeadAssignee")
  createdLeads        Lead[]            @relation("LeadCreator")
  notes               LeadNote[]
  statusEvents        LeadStatusEvent[]
  leadActivity        LeadActivity[]    @relation("LeadActivityActor")
  deals               Deal[]
  dealStageEvents     DealStageEvent[]
  referredRegistrations   Registration[] @relation("RegistrationReferrer")
  handledRegistrations    Registration[] @relation("RegistrationHandler")
  whatsappMessages        WhatsAppMessage[] @relation("WaRecipient")

  @@index([role, active])
}

/* ── לידים ──────────────────────────────────────────────────────────── */

/// סדר ההצהרה תואם בכוונה לסדר האמיתי (STATUS_ORDER ב-types.ts) —
/// MySQL ממיין enum-ים לפי סדר ההצהרה (האינדקס הפנימי), וה-repository נשען על כך.
enum LeadStatus {
  new
  inProgress
  contacted
  quoteSent
  awaitingClient
  followUp
  futureTracking
  won
  notRelevant
  notInterested
  existingCustomer
  noAnswer
  noAnswer1
  noAnswer2
  returning
  soldByCompetitor
  denies
  lost
}

enum LeadKind {
  hot
  data
}

enum Priority {
  normal
  high
  urgent
}

enum LeadSource {
  manual
  import
  form
  campaign
  referral
}

/// קטגוריית חבילה בקטלוג. שונה מ-LeadCategory (ראה למטה).
enum Category {
  internet
  mobile
  tv
  triple
  fiber
  electricity
}

/// קטגוריית עניין של ליד. שונה מ-Category — יש "general", אין "fiber".
enum LeadCategory {
  mobile
  internet
  tv
  triple
  electricity
  general
}

enum Provider {
  bezeq
  hot
  yes
  cellcom
  partner
  pelephone
  golan
  ibc
}

model Lead {
  id       String  @id @default(cuid())
  name     String
  phone    String
  email    String?
  city     String?

  kind     LeadKind   @default(data)
  status   LeadStatus @default(new)
  priority Priority   @default(normal)
  source   LeadSource @default(manual)

  category        LeadCategory?
  currentProvider Provider?

  /// עלות רכישת הליד. null = השתמש בעלות של הקטגוריה (טבלת LeadCost).
  /// 0 הוא ערך אמיתי — "הליד הזה היה חינם" — ולכן העמודה nullable.
  cost      Decimal? @db.Decimal(10, 2)
  isStarred Boolean  @default(false)

  /// מאיפה הליד הגיע, כטקסט חופשי: שם הקמפיין, החבילה או הספק
  /// ("פלאפון – 300GB Perfect", "Easy Peasy"). משלים את `source`,
  /// שהוא רשימה סגורה ומתאר רק את *אופן* הקליטה (ידני/ייבוא/טופס).
  sourceDetail String?

  /// החבילה שהלקוח התעניין בה, כטקסט חופשי ("500GB 5G Together").
  ///
  /// טקסט ולא קשר ל-Package בכוונה: שותפים חיצוניים שולחים את שם
  /// החבילה כמחרוזת שלהם, שכמעט לעולם לא תואמת בדיוק לשם בקטלוג
  /// שלנו. אילוץ התאמה היה מוביל לאיבוד המידע כשאין התאמה — וזה
  /// בדיוק המידע שהסוכן צריך לפני שהוא מרים טלפון.
  ///
  /// הקישור לקטלוג האמיתי קורה בשלב העסקה (`Deal.packages`), שם
  /// כבר יודעים איזו חבילה נסגרה בפועל.
  packageName String?

  assigneeId String?
  assignee   User?   @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("LeadCreator", fields: [createdById], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastContactAt DateTime?
  followUpAt    DateTime?

  notes            LeadNote[]
  history          LeadStatusEvent[]
  activity         LeadActivity[]
  deal             Deal?
  whatsappMessages WhatsAppMessage[]

  // טלפון הוא מפתח הכפילות בפועל — ייבוא CSV נשען עליו
  @@index([phone])
  @@index([status, updatedAt])
  @@index([assigneeId, status])
  @@index([followUpAt])
}

model LeadNote {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// פעולות על הליד שאינן שינוי סטטוס — יצירה, שיוך, עלות, סימון.
///
/// טבלה נפרדת ולא הרחבה של LeadStatusEvent: שם `to` הוא non-null וכל
/// הקוראים מניחים שכל רשומה היא מעבר סטטוס אמיתי. עירוב היה מחייב
/// להפוך אותו ל-nullable ולשבור אותם.
enum LeadActivityType {
  created
  assigned
  unassigned
  imported
  costChanged
  starred
  unstarred
}

model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type   LeadActivityType
  detail String?

  /// היעד של הפעולה, כשרלוונטי (למשל העובד שהליד שויך אליו)
  targetUserId String?

  actorId String
  actor   User   @relation("LeadActivityActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// כל שינוי סטטוס נשמר עם הפירוט שהסוכן הזין. זו היסטוריית הליד.
model LeadStatusEvent {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  from   LeadStatus?
  to     LeadStatus
  detail String?

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/* ── חבילות ─────────────────────────────────────────────────────────── */

model Package {
  id          String   @id @default(cuid())
  name        String
  provider    Provider
  category    Category
  /// מחיר חודשי ללקוח. null לחבילות חשמל — אין להן מחיר קבוע.
  price       Decimal? @db.Decimal(10, 2)
  /// עמלת סגירה למשווק — תמיד קיים, גם לחשמל.
  commission  Decimal  @db.Decimal(10, 2)
  /// שדות שמשתנים לפי קטגוריה (ג'יגה, מהירות הורדה, אחוז הנחה וכו').
  /// ראה PACKAGE_SPEC_FIELDS ב-types.ts למקור האמת של אילו שדות שייכים לאיזו קטגוריה.
  spec        Json     @default("{}")
  description String?
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals DealPackage[]

  @@index([provider, category])
  @@index([active])
}

/* ── עסקאות ─────────────────────────────────────────────────────────── */

/// שלבי מעקב הזמנה — סטפר רב-שלבי, לא רק סטטוס יחיד.
enum DealStage {
  new
  sentToAktiv
  inProgress
  apiProcess
  registered
  awaitingShipment
  awaitingPorting
  awaitingInstall
  active
  approved
  rejected
  cancelled
}

model Deal {
  id String @id @default(cuid())

  /// מזהה תצוגה קצר (כמו "10001"), נפרד מ-id הפנימי
  displayId String @unique

  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id])

  agentId String
  agent   User   @relation(fields: [agentId], references: [id])

  /// קטגוריית הליד המקורי, מועתקת בזמן יצירת העסקה
  category LeadCategory

  /// סכום שנגבה מהלקוח
  revenue      Decimal   @db.Decimal(10, 2)
  note         String?
  currentStage DealStage @default(new)
  closedAt     DateTime  @default(now())

  packages     DealPackage[]
  stageHistory DealStageEvent[]

  @@index([agentId, closedAt])
  @@index([closedAt])
}

/// טבלת קישור — עסקה יכולה לכלול כמה חבילות (טריפל + סלולר וכו').
model DealPackage {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  /// העמלה נשמרת כפי שהייתה ברגע הסגירה, כדי ששינוי מחירון
  /// בעתיד לא ישכתב עמלות היסטוריות.
  commissionAtClose Decimal @db.Decimal(10, 2)

  @@id([dealId, packageId])
}

/// היסטוריית שלבי עסקה — מראה את LeadStatusEvent. מאפשרת ל-stepper
/// להראות אילו שלבים העסקה כבר עברה, לא רק את הנוכחי.
model DealStageEvent {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  from   DealStage?
  to     DealStage
  detail String?

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
}

/* ── הגדרות ─────────────────────────────────────────────────────────── */

/// עלות רכישת ליד לפי קטגוריית ליד. שורה אחת לכל קטגוריה.
model LeadCost {
  category LeadCategory @id
  cost     Decimal      @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt
}

/* ── טפסי רישום (הפניית שותפים) ────────────────────────────────────── */

enum RegistrationStatus {
  pending
  handled
  rejected
}

/// פנייה של בעל עסק חיצוני להצטרפות כשותף — דרך טופס ציבורי משותף,
/// לא ליד מכירה. ישות נפרדת לגמרי מ-Lead.
model Registration {
  id           String  @id @default(cuid())
  businessName String
  contactName  String
  phone        String
  email        String?
  /// תיאור חופשי של ערוץ ההפניה, למשל "ONE STOP" או שם עובד
  referralSource String

  referredByUserId String?
  referredBy       User?   @relation("RegistrationReferrer", fields: [referredByUserId], references: [id], onDelete: SetNull)

  status RegistrationStatus @default(pending)

  createdAt DateTime  @default(now())
  handledAt DateTime?

  handledById String?
  handledBy   User?   @relation("RegistrationHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([referredByUserId])
}

/* ── תזכורות וואטסאפ ────────────────────────────────────────────────── */

enum WaMessageStatus {
  queued
  sending
  sent
  failed
  cancelled
}

/// תור ההודעות היוצאות לוואטסאפ.
///
/// ה-CRM מחליט מה נשלח ולמי ומרנדר את הטקסט; הבוט שרץ על המחשב במשרד
/// רק מושך שורות, שולח, ומדווח. כל ההיגיון והעברית נשארים כאן.
///
/// `toPhone` ו-`body` הם snapshot ולא נגזרים בזמן השליחה: אחרי שההודעה
/// יצאה, מה שנשלח בפועל הוא עובדה היסטורית שלא משתנה כשהליד מתעדכן.
model WhatsAppMessage {
  id String @id @default(cuid())

  /// המפתח שמונע כפילות. לתזכורת חזרה: `followup:<leadId>:<followUpAt ISO>`.
  /// תזמון מחדש מייצר מפתח חדש (= חובה חדשה), ואותה שעה פעמיים היא no-op.
  dedupeKey String @unique

  /// E.164 בלי הפלוס, כפי שוואטסאפ מזהה נמען
  toPhone String
  /// הטקסט המלא בעברית, מרונדר בשרת
  body    String

  status       WaMessageStatus @default(queued)
  /// מתי ההודעה אמורה לצאת. הבוט לא תובע שורות עתידיות.
  scheduledFor DateTime
  /// עולה בכל תביעה. 3 כישלונות = failed, כדי ששורה תקועה לא תסתובב לנצח.
  attempts     Int             @default(0)
  lastError    String?
  claimedAt    DateTime?
  sentAt       DateTime?

  /// SetNull ולא Cascade: הגוף והמספר הם snapshot, ומחיקת ליד לא צריכה
  /// למחוק את הראיה שההודעה נשלחה
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  recipientUserId String?
  recipient       User?   @relation("WaRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status, scheduledFor])
  @@index([leadId, status])
}

/// דופק הבוט — שורה יחידה (`id = "default"`).
///
/// הבוט רץ על מחשב במשרד שאף אחד לא מסתכל עליו. בלי הדופק הזה,
/// "לא הגיעו תזכורות" ו"לא היו תזכורות" נראים בדיוק אותו דבר.
model BotHeartbeat {
  id          String   @id @default("default")
  lastSeenAt  DateTime
  /// האם החיבור לוואטסאפ עצמו חי — תהליך שרץ בלי חיבור לא שולח כלום
  waConnected Boolean  @default(false)
  waNumber    String?
  instanceId  String?
  queuedCount Int      @default(0)
}

/// הגדרות הבוט שמנהל יכול לשנות מהאתר — שורה יחידה (`id = "default"`).
///
/// עד עכשיו כל אלה היו קבועים בקוד, כלומר כל שינוי דרש `git push`
/// ופריסה. הבעיה האמיתית היא לא הנוחות אלא הזמן: כשמתברר שהבוט שולח
/// משהו שגוי, "לעצור" חייב להיות לחיצה אחת ולא מחזור פריסה.
///
/// השורה נקראת בכל סקר של הבוט (כל 60 שניות), ולכן שינוי כאן נכנס
/// לתוקף תוך דקה בלי להפעיל שום דבר מחדש.
model BotSettings {
  id String @id @default("default")

  /// מתג ההשבתה. כשדולק הבוט ממשיך לדווח דופק אבל לא תובע שום שורה —
  /// התור מצטבר ולא הולך לאיבוד, בדיוק כמו כשהמחשב במשרד כבוי.
  paused       Boolean   @default(false)
  pausedReason String?
  pausedAt     DateTime?

  /// חלון השליחה בשעון ישראל. מחוצה לו שורות נכנסות לתור ונדחות לבוקר.
  sendWindowStartHour Int @default(8)
  sendWindowEndHour   Int @default(21)

  /// תקרת הודעות ליום קלנדרי (שעון ישראל). 0 = בלי תקרה.
  ///
  /// לתזכורות פנימיות זה כמעט לא רלוונטי, אבל זו רשת הביטחון היחידה
  /// מפני באג שמייצר לולאת שליחה — ומספר וואטסאפ ששולח מאות הודעות
  /// ביום נחסם.
  dailyCap Int @default(200)

  updatedAt   DateTime @updatedAt
  updatedById String?
}
