# העתק את הקובץ הזה ל-.env ומלא ערכים אמיתיים.
# .env לא נכנס ל-git (ראה .gitignore).

# חיבור ל-Supabase (Postgres). שני URL-ים נפרדים — ב-Project Settings ->
# Database -> Connect -> ORM (Prisma) ב-supabase.com:
#   DATABASE_URL — ה-pooler המשותף, transaction mode, פורט 6543. ה-runtime
#     (Next.js) מתחבר דרכו.
#   DIRECT_URL   — חיבור ישיר, session mode, פורט 5432. כלי המיגרציה של
#     Prisma זקוקים לחיבור ישיר (ה-pooler לא תומך ב-DDL/prepared statements).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# memory (ברירת מחדל, ריק — האתר רץ בלי DB) | prisma (דורש DATABASE_URL/DIRECT_URL תקינים)
# כדי לחבר את ה-Supabase:
#   1. מלא את שני ה-URL-ים למעלה
#   2. npx prisma migrate dev --name init   (בונה את כל הטבלאות)
#   3. שנה כאן ל-prisma
DATA_SOURCE="memory"

# Supabase Auth — אימות מייל/סיסמה אמיתי (src/server/auth/supabase.ts).
# ב-Project Settings -> API Keys ב-supabase.com:
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# מפתח סודי — לא נטען ע"י קוד האפליקציה, רק לסקריפטים חד-פעמיים ליצירת/
# עדכון משתמשי Auth. לעולם לא לחשוף לצד לקוח.
SUPABASE_SECRET_KEY="sb_secret_..."

# ── גישה לגרסת הבדיקה ────────────────────────────────────────────────
# המפתח הסודי שמופיע בקישור שנשלח לבודקים:
#   https://<host>/?k=<ACCESS_KEY>
# ריק = השער פתוח לגמרי (נוח לפיתוח מקומי). בייצור חובה להגדיר.
#
# ⚠️ זו הסתרה, לא אבטחה. מי שקיבל את הקישור יכול להעביר אותו הלאה.
ACCESS_KEY=""

# ── קליטת לידים משותפים (POST /api/leads) ────────────────────────────
# רישום מפתחות ה-API של השותפים ששולחים לידים למערכת.
# פורמט: זוגות `מפתח:שם-שותף`, מופרדים בפסיק:
#   LEADS_API_KEYS="os_moshe_a1b2c3d4e5:משה,os_dana_9f8e7d:דנה"
# שם השותף נרשם בעמודת "מקור" של הליד, אם השותף לא שלח `source` משלו.
#
# ריק = אין שותפים מורשים וכל בקשה נדחית ב-401. ראה docs/leads-api.md
# למסמך החוזה שנשלח לשותף.
LEADS_API_KEYS=""

# ברירת המחדל: ליד שנכנס מה-API נשאר **ללא שיוך** וההנהלה מחלקת אותו.
# "on" מפעיל חלוקה אוטומטית לנציג הפעיל עם הכי מעט לידים פתוחים.
# בלי אף נציג פעיל אין למי לשייך, והליד נשאר ללא שיוך בכל מקרה.
LEADS_API_AUTO_ASSIGN=""

# יעד שיוך קבוע לפי שם השותף — **גובר על LEADS_API_AUTO_ASSIGN**.
# פורמט: זוגות `שם-שותף:אימייל`, מופרדים בפסיק. השם חייב להיות
# זהה לשם שרשום ב-LEADS_API_KEYS.
#   LEADS_API_PARTNER_ASSIGNEE="עידן:aliran@onestop.co.il"
# שותף שאינו ברשימה, אימייל שאינו קיים, או עובד לא פעיל — נופלים
# חזרה להתנהגות הרגילה (חלוקה אוטומטית או ללא שיוך).
LEADS_API_PARTNER_ASSIGNEE=""

# מפתח לבוט תזכורות הוואטסאפ שרץ על המחשב במשרד.
# רישום נפרד מ-LEADS_API_KEYS בכוונה: אין סיבה שמפתח שיושב על
# מחשב במשרד יוכל גם ליצור לידים.
# פורמט: מפתח:שם, מופרדים בפסיק.
WHATSAPP_API_KEYS="os_bot_xxxxxxxx:בוט המשרד"

# כתובת המערכת, לקישור בתוך הודעות התזכורת.
APP_URL="https://onestop-crm-demo.vercel.app"

# ─── דף הנחיתה הציבורי (/lp) ─────────────────────────────────────────
# העובד שכל ליד מהדף משויך אליו, לפי המייל שלו ב-CRM.
# ⚠️ עובד שאינו קיים או אינו פעיל אינו מפיל את הטופס — הליד נשמר
# ללא שיוך ומחכה במאגר שההנהלה רואה. עדיף ליד בלי בעלים על ליד שאבד.
LANDING_ASSIGNEE_EMAIL="aliran@onestop.co.il"

# מה שנרשם בעמודת "מקור" של כל ליד מהדף — כך מסננים אותם יחד.
LANDING_SOURCE_DETAIL="האתר של אלירן"

# ─── דיוור במייל (/mailer) ────────────────────────────────────────────
# שליחה דרך חשבון Gmail עם **סיסמת אפליקציה** (לא סיסמת החשבון).
# דורש אימות דו-שלבי פעיל, ואז myaccount.google.com/apppasswords.
#
# ⚠️ למה Gmail ולא ספק דיוור: כתובת gmail.com ששולחת דרך שרתי ספק
# צד-שלישי אינה עוברת יישור SPF/DKIM ונוחתת בספאם. שליחה מ-Gmail
# דרך Gmail מיושרת. המחיר: ~500 ליום ואין דוחות פתיחה.
#
# בלי שני אלה המסך עולה אבל שום דבר לא יוצא.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# הסוד שחותם על קישורי ההסרה מרשימת התפוצה.
# ⚠️ החלפתו מבטלת כל קישור הסרה שכבר נשלח — מי שילחץ יקבל "קישור לא
# תקין" ולא יוכל להסיר את עצמו. זו חשיפה חוקית, לא אי-נוחות.
# ייצור: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAILER_SECRET=""

# השם שהנמען רואה ליד הכתובת. ריק = "ONE STOP".
# ⚠️ מייל מכתובת ג'ימייל חשופה בלי שם נראה כמו הודעה מאדם אקראי,
# ומסונן חזק יותר.
MAILER_FROM_NAME=""
